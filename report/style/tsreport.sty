% tsreport.sty -- layout, colours and environments for the Table-Specialist reproduction report.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{tsreport}[2026/11/16 Table-Specialist reproduction report style]

% ---------------------------------------------------------------- fonts and page
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage{libertinus}
\RequirePackage[scaled=0.92]{zi4}
\RequirePackage[a4paper,top=2.6cm,bottom=2.6cm,left=2.4cm,right=2.4cm,headheight=15pt]{geometry}
\RequirePackage{microtype}
\RequirePackage[english]{babel}
\RequirePackage{csquotes}
\linespread{1.06}
\setlength{\parskip}{0.45em}
\setlength{\parindent}{0pt}

% ---------------------------------------------------------------- colour palette
\RequirePackage[table,dvipsnames]{xcolor}
\definecolor{navy}{HTML}{1F3A5F}
\definecolor{teal}{HTML}{1F7A8C}
\definecolor{sea}{HTML}{2A9D8F}
\definecolor{amber}{HTML}{E9A23B}
\definecolor{coral}{HTML}{D1495B}
\definecolor{plum}{HTML}{6A4C93}
\definecolor{slate}{HTML}{5C6B7A}
\definecolor{rowshade}{HTML}{EEF3F8}
\definecolor{headshade}{HTML}{D4E1EE}
\definecolor{paperbg}{HTML}{FFF7E6}
\definecolor{oursbg}{HTML}{E8F4F2}
\definecolor{good}{HTML}{2E7D32}
\definecolor{bad}{HTML}{C62828}

% ---------------------------------------------------------------- maths, tables, figures
\RequirePackage{amsmath,amssymb,amsthm,mathtools,bm}
\RequirePackage{booktabs,longtable,tabularx,multirow,array,pdflscape,makecell}
\RequirePackage{graphicx,caption,subcaption,float,adjustbox}
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta,positioning,shapes.geometric,shapes.misc,fit,calc,backgrounds,shadows.blur}
\RequirePackage{pgfplots}
\pgfplotsset{compat=1.18}
\usepgfplotslibrary{groupplots}
\RequirePackage{enumitem}
\setlist{itemsep=0.25em,topsep=0.35em}
\RequirePackage{listings}
\lstset{basicstyle=\ttfamily\footnotesize,columns=fullflexible,breaklines=true,frame=single,
  rulecolor=\color{headshade},backgroundcolor=\color{rowshade!60},numbers=left,numberstyle=\tiny\color{slate},
  keywordstyle=\color{navy}\bfseries,commentstyle=\color{slate}\itshape,stringstyle=\color{teal}}
\captionsetup{font=small,labelfont={bf,color=navy},format=hang,justification=raggedright,singlelinecheck=false}
\captionsetup[longtable]{font=small,labelfont={bf,color=navy}}
\setlength{\LTcapwidth}{\textwidth}
\renewcommand{\arraystretch}{1.18}

% ---------------------------------------------------------------- algorithms
\RequirePackage[ruled,vlined,linesnumbered]{algorithm2e}
\SetAlCapFnt{\small\bfseries\color{navy}}
\SetAlCapNameFnt{\small}
\SetKwInput{KwIn}{Input}
\SetKwInput{KwOut}{Output}
\newcommand\tscommfont[1]{\footnotesize\itshape\textcolor{slate}{#1}}
\SetCommentSty{tscommfont}
\SetKwComment{Comment}{$\triangleright$\ }{}

% ---------------------------------------------------------------- headings
\RequirePackage{titlesec}
\titleformat{\chapter}[display]
  {\normalfont\sffamily\color{navy}}
  {\begin{tikzpicture}\node[fill=navy,text=white,rounded corners=3pt,inner sep=7pt,font=\sffamily\bfseries\Large]
     {\MakeUppercase{\chaptertitlename}~\thechapter};\end{tikzpicture}}
  {12pt}{\Huge\bfseries}[\vspace{4pt}{\color{sea}\titlerule[1.6pt]}]
\titleformat{name=\chapter,numberless}[display]{\normalfont\sffamily\color{navy}}{}{0pt}{\Huge\bfseries}
  [\vspace{4pt}{\color{sea}\titlerule[1.6pt]}]
\titlespacing*{\chapter}{0pt}{-10pt}{24pt}
\titleformat{\section}{\normalfont\sffamily\Large\bfseries\color{navy}}{\color{sea}\thesection}{0.8em}{}
\titleformat{\subsection}{\normalfont\sffamily\large\bfseries\color{teal}}{\thesubsection}{0.8em}{}
\titleformat{\subsubsection}{\normalfont\sffamily\normalsize\bfseries\color{slate}}{\thesubsubsection}{0.8em}{}
\setcounter{secnumdepth}{3}
\setcounter{tocdepth}{2}

% ---------------------------------------------------------------- headers and footers
\RequirePackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\sffamily\footnotesize\color{slate}\nouppercase{\leftmark}}
\fancyhead[R]{\sffamily\footnotesize\color{slate}Table-Specialist reproduction}
\fancyfoot[C]{\sffamily\small\color{navy}\thepage}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\headrule}{\hbox to\headwidth{\color{headshade}\leaders\hrule height \headrulewidth\hfill}}
\fancypagestyle{plain}{\fancyhf{}\fancyfoot[C]{\sffamily\small\color{navy}\thepage}\renewcommand{\headrulewidth}{0pt}}

% ---------------------------------------------------------------- boxes for provenance and claims
\RequirePackage[most]{tcolorbox}
\newtcolorbox{paperbox}[1][]{enhanced,breakable,colback=paperbg,colframe=amber,boxrule=0.6pt,arc=2pt,
  left=6pt,right=6pt,top=4pt,bottom=4pt,fonttitle=\sffamily\bfseries\small,coltitle=black,
  title={From the original paper},#1}
\newtcolorbox{oursbox}[1][]{enhanced,breakable,colback=oursbg,colframe=sea,boxrule=0.6pt,arc=2pt,
  left=6pt,right=6pt,top=4pt,bottom=4pt,fonttitle=\sffamily\bfseries\small,title={Our implementation},#1}
\newtcolorbox{observation}[1][]{enhanced,breakable,colback=white,colframe=navy,boxrule=0.6pt,arc=2pt,
  left=6pt,right=6pt,top=4pt,bottom=4pt,fonttitle=\sffamily\bfseries\small,title={Measured observation},#1}
\newtcolorbox{interpretation}[1][]{enhanced,breakable,colback=white,colframe=plum,boxrule=0.6pt,arc=2pt,
  left=6pt,right=6pt,top=4pt,bottom=4pt,fonttitle=\sffamily\bfseries\small,title={Interpretation},#1}
\newtcolorbox{hypothesis}[1][]{enhanced,breakable,colback=white,colframe=coral,boxrule=0.6pt,arc=2pt,
  left=6pt,right=6pt,top=4pt,bottom=4pt,fonttitle=\sffamily\bfseries\small,title={Hypothesis (not verified)},#1}
\newtcolorbox{keypoint}[1][]{enhanced,breakable,colback=headshade!45,colframe=headshade,boxrule=0pt,arc=2pt,
  left=8pt,right=8pt,top=5pt,bottom=5pt,borderline west={3pt}{0pt}{navy},#1}
\newtcolorbox{failbox}[1]{enhanced,breakable,colback=white,colframe=coral!85!black,boxrule=0.7pt,arc=2pt,
  left=6pt,right=6pt,top=4pt,bottom=4pt,borderline west={3pt}{0pt}{coral}}

% ---------------------------------------------------------------- references
\RequirePackage[obeyspaces,spaces,hyphens]{url}
\RequirePackage[backend=biber,style=numeric-comp,sorting=none,maxbibnames=8,giveninits=true,url=true,doi=true]{biblatex}
\RequirePackage[colorlinks=true,linkcolor=navy,citecolor=teal,urlcolor=plum,bookmarksnumbered=true,
  pdftitle={Table-Specialist reproduction: technical and research report}]{hyperref}
\RequirePackage[nameinlink,capitalise,noabbrev]{cleveref}
\crefname{algocf}{Algorithm}{Algorithms}

% ---------------------------------------------------------------- shorthands
\newcommand{\TS}{\textsc{ts}}
\newcommand{\NV}{\textsc{nv}}
\newcommand{\RTS}{repair-\textsc{ts}}
\newcommand{\Mviii}{\textsf{M8}}
\newcommand{\ZSiv}{\textsf{ZS4}}
% file paths: typewriter, breakable after _ / . , < > { } so that long identifiers wrap inside table cells
\makeatletter
\g@addto@macro\UrlBreaks{\do\_\do\<\do\>\do\{\do\}\do\,}
\makeatother
\DeclareRobustCommand{\fpath}[1]{\nolinkurl{#1}}
\pdfstringdefDisableCommands{\def\fpath#1{#1}}
\newcommand{\unverified}{\textsuperscript{\textcolor{coral}{\dag}}}
\newcommand{\genref}[1]{Table~\ref{#1}}
