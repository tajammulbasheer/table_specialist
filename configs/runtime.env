# Sourced before serving or training. Both settings were found necessary on this machine under WSL2.
# FlashInfer sampling compiles itself with nvcc, which is not installed.
VLLM_USE_FLASHINFER_SAMPLER=0
# Do not set PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True here: it fails under WSL2 with
# "Failed to create GPU mapping" from cuMemSetAccess.
